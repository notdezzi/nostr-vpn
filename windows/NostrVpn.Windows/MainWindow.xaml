                        <Button DockPanel.Dock="Right" Content="Connect" Tag="{Binding}" Click="BuyPaidRouteOffer_Click" IsEnabled="{Binding CanUseProvider}" Margin="8,0,0,0" />
                        <StackPanel>
                          <WrapPanel>
                            <TextBlock Text="{Binding DisplayCountry}" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayPrice}" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding DisplayRating}" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0" />
                          </WrapPanel>
                          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding DisplayMetricText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="{Binding DisplayMetricText, Converter={StaticResource NonEmptyStringToVisibility}}" />
