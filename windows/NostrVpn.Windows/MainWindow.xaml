                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Your Paid Internet" FontWeight="SemiBold" Margin="0,8,0,6" />
                <ItemsControl ItemsSource="{Binding State.PaidRouteMarket.Sessions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button x:Name="ExitThumbUp" Content="{Binding RatingUpText}" Tag="{Binding}" Click="RatePaidExit_Click" Visibility="{Binding CanRate, Converter={StaticResource BoolToVisibility}}" ToolTip="Publish or clear your positive rating" Margin="0,0,6,0" />
                          <Button x:Name="ExitThumbDown" Content="{Binding RatingDownText}" Tag="{Binding}" Click="RatePaidExit_Click" Visibility="{Binding CanRate, Converter={StaticResource BoolToVisibility}}" ToolTip="Publish or clear your negative rating; stops this provider" Margin="0,0,6,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Content="Connect" Tag="{Binding}" Click="UsePaidRouteSession_Click" IsEnabled="{Binding CanUseProvider}" Margin="0,0,6,0" />
                          <Button Content="Probe" Tag="{Binding}" Click="ProbePaidRouteSession_Click" Margin="0,0,6,0" />
                          <Button Content="Fund" Tag="{Binding}" Click="OpenPaidRouteChannel_Click" IsEnabled="{Binding CanOpenChannel}" Margin="0,0,6,0" />
                          <Button Content="Pay" Tag="{Binding}" Click="SignPaidRoutePayment_Click" IsEnabled="{Binding CanPay}" Margin="0,0,6,0" />
                          <Button Content="Settle" Tag="{Binding}" Click="ClosePaidRouteChannel_Click" IsEnabled="{Binding CanSettleChannel}" />
                        </StackPanel>
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                          <WrapPanel>
                            <TextBlock Text="{Binding DisplayDetail}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayLocationText}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" Visibility="{Binding DisplayLocationText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                            <TextBlock Text="{Binding DisplayPaidText}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayBehindText}" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding DisplayBehindText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                          </WrapPanel>
                          <TextBlock Text="{Binding DisplayMetricText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="{Binding DisplayMetricText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                          <TextBlock Text="{Binding DisplaySettlementText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="{Binding DisplaySettlementText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <controls:WalletView />

          <!-- ==================== Sell Access ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=SellAccess}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Share My Internet" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding PaidExitSellerStatusText}" Style="{StaticResource HelperText}" Margin="0,0,0,8" />
                <StackPanel Visibility="{Binding PaidExitSellerVisible, Converter={StaticResource BoolToVisibility}}">
                  <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Share my internet" IsChecked="{Binding State.PaidExitSeller.Enabled, Mode=OneWay}" Click="PaidExitEnabled_Click" />
                  <TextBlock Text="{Binding PaidExitSellerChannelCreditText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding PaidExitSellerChannelCreditHelpText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" Visibility="{Binding PaidExitSellerChannelCreditHelpText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                  <TextBlock Text="{Binding PaidExitSellerPaymentStatusText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" Visibility="{Binding PaidExitSellerPaymentStatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                  <TextBlock Text="{Binding PaidExitSellerSummary}" Style="{StaticResource HelperText}" Margin="0,0,0,6" />
                  <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Save price" Click="SavePaidExitPrice_Click" IsEnabled="{Binding CanSavePaidExitPrice}" Margin="8,0,0,0" />
                    <TextBlock DockPanel.Dock="Right" Text="msat/GB" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding PaidExitPriceMsatPerGb, UpdateSourceTrigger=PropertyChanged}" ToolTip="Price in msat/GB" AutomationProperties.AutomationId="PaidExitPriceMsatPerGb" />
                  </DockPanel>
                  <DockPanel LastChildFill="True" Margin="0,0,0,6" Visibility="{Binding State.PaidExitSeller.ProviderLink, Converter={StaticResource NonEmptyStringToVisibility}}">
                    <Button DockPanel.Dock="Right" Content="Copy link" Tag="{Binding State.PaidExitSeller.ProviderLink}" Click="CopyWalletValue_Click" Margin="8,0,0,0" />
                    <TextBox Text="{Binding State.PaidExitSeller.ProviderLink}" IsReadOnly="True" />
                  </DockPanel>
                  <TextBlock Text="{Binding PaidExitSellerTrialText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding PaidExitSellerChannelExpiryText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding PaidExitSellerSettlementText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" Visibility="{Binding PaidExitSellerSettlementText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                  <TextBlock Text="{Binding PaidExitSellerPublicIpText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" Visibility="{Binding PaidExitSellerPublicIpText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                  <TextBlock Text="{Binding PaidExitSellerMintsText}" Style="{StaticResource HelperText}" Margin="0,0,0,6" />
                  <TextBlock Text="{Binding PaidExitSellerSessionsText}" Style="{StaticResource HelperText}" Margin="0,0,0,10" />
                  <TextBlock Text="Active Customers" FontWeight="SemiBold" Margin="0,8,0,6" />
                  <ItemsControl ItemsSource="{Binding State.PaidExitSeller.Sessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                          <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                          <WrapPanel>
                            <TextBlock Text="{Binding DisplayDetail}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayPaidText}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayBehindText}" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding DisplayBehindText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                          </WrapPanel>
                          <TextBlock Text="{Binding DisplayMetricText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="{Binding DisplayMetricText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                          <TextBlock Text="{Binding DisplaySettlementText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="{Binding DisplaySettlementText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ==================== Settings ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="Theme" FontWeight="SemiBold" />
                <WrapPanel Margin="0,4,0,0">
                  <RadioButton Content="System" IsChecked="{Binding ThemeIsSystem, Mode=TwoWay}" AutomationProperties.AutomationId="ThemeSystemOption" />
                  <RadioButton Content="Light" IsChecked="{Binding ThemeIsLight, Mode=TwoWay}" AutomationProperties.AutomationId="ThemeLightOption" />
                  <RadioButton Content="Dark" IsChecked="{Binding ThemeIsDark, Mode=TwoWay}" AutomationProperties.AutomationId="ThemeDarkOption" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Connect automatically when the app starts" IsChecked="{Binding State.Autoconnect, Mode=OneWay}" Click="Autoconnect_Click" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Start Nostr VPN when I log in to Windows" IsChecked="{Binding State.LaunchOnStartup, Mode=OneWay}" Click="LaunchOnStartup_Click" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Keep running in the notification area when the window is closed" IsChecked="{Binding State.CloseToTrayOnClose, Mode=OneWay}" Click="CloseToTray_Click" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                  <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckUpdatesCommand}" Margin="12,0,0,0" />
                  <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                           Visibility="{Binding UpdateStatus, Converter={StaticResource NonEmptyStringToVisibility}}" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Install updates automatically" IsChecked="{Binding AutoInstallUpdates, Mode=TwoWay}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Network" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding HasActiveNetwork, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Visibility="{Binding HasActiveNetwork, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Network name" FontWeight="SemiBold" />
                  <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NetworkNameDraft, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Save" Command="{Binding SaveNetworkNameCommand}" />
                  </Grid>
                  <Button Content="Remove this network" HorizontalAlignment="Left" Tag="{Binding ActiveNetwork.Id}" Click="RemoveNetwork_Click" Margin="0,0,0,8" />
                </StackPanel>
                <Button Content="Create or join a network" Command="{Binding ShowAddNetworkCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding InactiveNetworks}" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button Content="Activate" Tag="{Binding Id}" Click="ActivateNetwork_Click" Margin="0,0,8,0" />
                          <Button Content="Remove" Tag="{Binding Id}" Click="RemoveNetwork_Click" />
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Internet" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Share this device's internet" IsChecked="{Binding State.AdvertiseExitNode, Mode=OneWay}" Click="AdvertiseExit_Click" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Block internet if the source disconnects" IsChecked="{Binding State.ExitNodeLeakProtection, Mode=OneWay}" Click="ExitLeakProtection_Click" />
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Choose internet source…" Command="{Binding ShowInternetCommand}" Margin="0,0,8,0" />
                  <Button Content="Sell internet access · Experimental" Command="{Binding ShowSellAccessCommand}" Visibility="{Binding PaidExitSellerVisible, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="This device" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="Device name" FontWeight="SemiBold" />
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Content="Save" Command="{Binding SaveNodeCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource HelperText}" Margin="0,8,0,0">
                  <Run Text="VPN IP: " /><Run Text="{Binding State.TunnelIp, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Pro settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Show pro settings" IsChecked="{Binding IsProMode, Mode=TwoWay}" />
                <TextBlock Text="Advanced options for relays, FIPS, the wallet display, and system tools." Style="{StaticResource HelperText}" />
              </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsProMode, Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="This device · advanced" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Endpoint" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8" />
                    <TextBlock Grid.Column="2" Text="Listen Port" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Tunnel IP" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TunnelIp, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8" />
                    <TextBlock Grid.Row="2" Text="Public .fips inbound TCP ports" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding FipsHostInboundTcpPorts, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated port numbers" />
                  </Grid>
                  <Button Content="Save" Command="{Binding SaveNodeCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Nostr relays" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                  <TextBlock Text="Servers that carry coordination traffic for your networks." Style="{StaticResource HelperText}" Margin="0,0,0,10" />
                  <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddRelayCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding RelayInput, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding State.Relays}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                          <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,8,0">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StatusDotIdle}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Connected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource StatusDotOk}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <Button DockPanel.Dock="Right" Content="Delete" Tag="{Binding}" Click="RemoveRelay_Click" Margin="8,0,0,0" />
                          <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}" Click="RelayEnabled_Click" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="FIPS" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Connect to non-roster FIPS peers" IsChecked="{Binding State.ConnectToNonRosterFipsPeers, Mode=OneWay}" Click="ConnectToNonRosterFipsPeers_Click" />
                  <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Find peers over Nostr relays" IsChecked="{Binding State.FipsNostrDiscoveryEnabled, Mode=OneWay}" Click="FipsNostrDiscoveryEnabled_Click" />
                  <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Use bootstrap servers" IsChecked="{Binding State.FipsBootstrapEnabled, Mode=OneWay}" Click="FipsBootstrapEnabled_Click" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Public FIPS address" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,8">
                    <Run Text="FIPS gives .fips addresses end-to-end encryption and identity-based routing. Hosts can reach each other without static IPs, domain names, TLS certificates, or NAT port forwarding. " />
                    <Hyperlink NavigateUri="https://learn.fips.network/" RequestNavigate="OpenHyperlink_RequestNavigate">Learn FIPS</Hyperlink>
                  </TextBlock>
                  <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Keep npub.fips outside the tunnel" IsChecked="{Binding State.FipsHostTunnelEnabled, Mode=OneWay}" Click="FipsHostTunnel_Click" />
                  <Grid Margin="0,8,0,0" IsEnabled="{Binding State.FipsHostTunnelEnabled}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="210" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Your public FIPS address" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    <TextBox Grid.Column="1" Text="{Binding PublicFipsAddress, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Text="Public .fips inbound TCP ports" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FipsHostInboundTcpPorts, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated port numbers" />
                  </Grid>
                  <Button Content="Save" Command="{Binding SaveNodeCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="{Binding PublicFipsRoutingEnabled}" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Visibility="{Binding PaidRouteMarketVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="Wallet display" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Show fiat value" IsChecked="{Binding State.WalletFiatEnabled, Mode=OneWay}" Click="WalletFiatEnabled_Click" />
                  <TextBlock Text="Rates from Coinbase and Kraken" Style="{StaticResource HelperText}" Margin="0,8,0,0" Visibility="{Binding State.WalletFiatEnabled, Converter={StaticResource BoolToVisibility}}" />
                  <ComboBox SelectedValue="{Binding State.WalletFiatCurrency, Mode=OneWay}" SelectedValuePath="Content" SelectionChanged="WalletFiatCurrency_Changed" Margin="0,10,0,0" Visibility="{Binding State.WalletFiatEnabled, Converter={StaticResource BoolToVisibility}}">
                    <ComboBoxItem Content="USD" /><ComboBoxItem Content="EUR" /><ComboBoxItem Content="GBP" />
                    <ComboBoxItem Content="CAD" /><ComboBoxItem Content="AUD" /><ComboBoxItem Content="JPY" /><ComboBoxItem Content="CHF" />
                  </ComboBox>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding SystemVersionLabel}"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12"
                               Visibility="{Binding SystemVersionLabel, Converter={StaticResource NonEmptyStringToVisibility}}" />
                    <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" />
                  </DockPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ServiceSummary}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding CliSummary}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource TextSecondary}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Install service" Command="{Binding InstallServiceCommand}" Margin="0,0,8,0" />
                    <Button Content="Enable" Command="{Binding EnableServiceCommand}" Margin="0,0,8,0" />
                    <Button Content="Disable" Command="{Binding DisableServiceCommand}" Margin="0,0,8,0" />
                    <Button Content="Install CLI" Command="{Binding InstallCliCommand}" Margin="0,0,8,0" />
                    <Button Content="Updates" Command="{Binding CheckUpdatesCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Expander Header="Diagnostics" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="Interface" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Column="1" Text="{Binding DiagnosticsInterface}" TextTrimming="CharacterEllipsis" Margin="0,0,16,8" />
                      <TextBlock Grid.Column="2" Text="Gateway" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Column="3" Text="{Binding DiagnosticsGateway}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="1" Text="IPv4" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagnosticsIpv4}" TextTrimming="CharacterEllipsis" Margin="0,0,16,8" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="IPv6" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DiagnosticsIpv6}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="2" Text="Mapping" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiagnosticsMapping}" TextTrimming="CharacterEllipsis" Margin="0,0,16,8" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="External" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DiagnosticsExternal}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="3" Text="Remote roster" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagnosticsPeers}" TextTrimming="CharacterEllipsis" Margin="0,0,16,8" />
                      <TextBlock Grid.Row="3" Grid.Column="2" Text="Roster FIPS" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                      <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DiagnosticsFips}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="4" Text="Other FIPS" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                      <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DiagnosticsOtherFips}" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding State.Health}" Margin="0,12,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Severity}" Foreground="{DynamicResource Warn}" FontWeight="SemiBold" Width="82" />
                            <StackPanel>
                              <TextBlock Text="{Binding Summary}" />
                              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Expander>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
