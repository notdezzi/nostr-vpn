<Window x:Class="NostrVpn.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NostrVpn.Windows.Controls"
        Title="Nostr VPN"
        Width="760"
        Height="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/nostr-vpn.ico"
        Foreground="{DynamicResource TextPrimary}"
        Background="{DynamicResource WindowBg}">
  <Window.Resources>
    <Style x:Key="ConnectPillButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="MinWidth" Value="300" />
      <Setter Property="Padding" Value="36,10" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid>
              <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="27" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding State.VpnEnabled}" Value="True">
          <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
          <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="20,10" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Nostr VPN" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource HeaderIconButton}" Command="{Binding ShowAccountCommand}" ToolTip="Account">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="15" />
          </Button>
          <Button Style="{StaticResource HeaderIconButton}" Command="{Binding ShowWalletCommand}"
                  Visibility="{Binding PaidRouteMarketVisible, Converter={StaticResource BoolToVisibility}}"
                  ToolTip="Wallet" Padding="10,0" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C7;" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding WalletNavigationText}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource HeaderIconButton}" Command="{Binding ShowSettingsCommand}" ToolTip="Settings" Margin="4,0,0,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Padding="24,4" Background="{DynamicResource UpdateBannerBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="Install automatically" IsChecked="{Binding AutoInstallUpdates, Mode=TwoWay}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0" />
          <Button Content="Install" Command="{Binding InstallUpdateCommand}" MinWidth="72" MinHeight="26" Padding="10,3" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="{Binding UpdateStripeText}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
      <Grid>
        <StackPanel Margin="24,18,24,24" MaxWidth="720" HorizontalAlignment="Center">
          <Border Style="{StaticResource Card}" Visibility="{Binding Notice, Converter={StaticResource NonEmptyStringToVisibility}}">
            <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
          </Border>

          <!-- ==================== Home ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Home}">
            <Button Style="{StaticResource CardButton}"
                    Click="NetworkSwitcherButton_Click"
                    Visibility="{Binding HasActiveNetwork, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="HomeNetworkSwitcher">
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding ShownNetworkStatusBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding ShowNetworkStatusDot, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ActiveNetworkName}" FontSize="20" FontWeight="SemiBold" />
                  </StackPanel>
                  <TextBlock Text="{Binding HeroSubtitle}" Style="{StaticResource HelperText}" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </Button>

            <Button Style="{StaticResource CardButton}"
                    Command="{Binding ShowAddNetworkCommand}"
                    Visibility="{Binding HasActiveNetwork, Converter={StaticResource InverseBoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Set up your network" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Create a new network, or join one you were invited to." Style="{StaticResource HelperText}" Margin="0,4,0,0" />
              </StackPanel>
            </Button>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasActiveNetwork, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Command="{Binding ShowAddDeviceCommand}" Content="+ Add device" Visibility="{Binding ActiveNetwork.LocalIsAdmin, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ManualJoinAdminOpen" />
                  <StackPanel>
                    <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HeroSubtitle}" Style="{StaticResource HelperText}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
                <ListBox x:Name="HomeDeviceList"
                         ItemsSource="{Binding ActiveNetwork.Participants}"
                         SelectedValue="{Binding SelectedParticipantKey, Mode=TwoWay}"
                         SelectedValuePath="SelectionKey"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="HomeDevices_SelectionChanged">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="0" />
                      <Setter Property="Cursor" Value="Hand" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="0,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,10,0">
                            <Ellipse.Style>
                              <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StatusDotIdle}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Reachable}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource StatusDotOk}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Ellipse.Style>
                          </Ellipse>
                          <StackPanel Grid.Column="1">
                            <WrapPanel>
                              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="This device" Margin="8,0,0,0" Foreground="{DynamicResource Ok}" Visibility="{Binding IsSelf, Converter={StaticResource BoolToVisibility}}" />
                              <TextBlock Text="Admin" Margin="8,0,0,0" Foreground="{DynamicResource Accent}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                              <TextBlock Text="Exit" Margin="8,0,0,0" Foreground="{DynamicResource Warn}" Visibility="{Binding OffersExitNode, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HelperText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding CleanTunnelIp, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ConnectivityStateText, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                          <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Button Style="{StaticResource CardButton}"
                    Command="{Binding ShowInternetCommand}"
                    Visibility="{Binding HasActiveNetwork, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="ExitDnsInternetNavigation">
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel>
                  <TextBlock Text="Internet" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding InternetSourceSummary}" Style="{StaticResource HelperText}" Margin="0,3,0,0" />
                </StackPanel>
              </DockPanel>
            </Button>

            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center" Visibility="{Binding HasActiveNetwork, Converter={StaticResource BoolToVisibility}}">
              <Button Style="{StaticResource ConnectPillButton}"
                      Command="{Binding ToggleVpnCommand}"
                      Content="{Binding ConnectButtonText}"
                      HorizontalAlignment="Center"
                      AutomationProperties.AutomationId="ConnectToggle" />
              <TextBlock Text="{Binding VpnHeadlineText}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding VpnHeadlineBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
              <TextBlock Text="{Binding VpnStatusText}" Style="{StaticResource HelperText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- ==================== Account ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Account}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>
            <TextBlock Text="Account" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="This device" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Name" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,0,8,8" />
                  <TextBlock Grid.Column="1" Text="{Binding State.NodeName}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="1" Text="MagicDNS" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,0,8,8" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding State.SelfMagicDnsName}" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="2" Text="VPN IP" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,0,8,0" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding State.TunnelIp}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Device ID" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Share this with a network admin so they can add you." Style="{StaticResource HelperText}" Margin="0,0,0,8" />
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right" Content="Copy" Tag="{Binding State.OwnNpub}" Click="CopyPeer_Click" Margin="8,0,0,0" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding State.OwnNpub}" TextWrapping="Wrap" />
                    </DockPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding SystemVersionLabel}" Style="{StaticResource HelperText}" Margin="0,12,0,0"
                           Visibility="{Binding SystemVersionLabel, Converter={StaticResource NonEmptyStringToVisibility}}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding PaidRouteMarketVisible, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Wallet" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding PaidRouteWalletBalanceText}" FontSize="26" FontWeight="Bold"
                           Visibility="{Binding PaidRouteWalletBalanceText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                <TextBlock Text="{Binding PaidRouteWalletSecondaryBalanceText}" Style="{StaticResource HelperText}"
                           Visibility="{Binding PaidRouteWalletSecondaryBalanceText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                <Button Content="Open wallet" Command="{Binding ShowWalletCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ==================== Devices ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Devices}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>

            <StackPanel Visibility="{Binding HasActiveNetwork, Converter={StaticResource InverseBoolToVisibility}}">
              <Border Style="{StaticResource Card}" Visibility="{Binding ShowNetworkSetupChoices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <Button Content="Create Network" Command="{Binding ShowCreateNetworkSetupCommand}" Margin="0,0,0,8" AutomationProperties.AutomationId="ManualJoinCreateNetworkChoice" />
                  <Button Content="Join Network" Command="{Binding ShowJoinNetworkSetupCommand}" AutomationProperties.AutomationId="ManualJoinChooseJoin" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Visibility="{Binding ShowNetworkSetupCreate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <Button Content="Back" Command="{Binding BackToNetworkSetupChoicesCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                  <TextBlock Text="Create Network" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NetworkNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.AutomationId="ManualJoinCreateNetworkName" />
                    <Button Grid.Column="1" Content="Create" Command="{Binding CreateNetworkCommand}" AutomationProperties.AutomationId="ManualJoinCreateNetworkSubmit" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Visibility="{Binding ShowNetworkSetupJoin, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <Button Content="Back" Command="{Binding BackToNetworkSetupChoicesCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                  <TextBlock Text="Join Network" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="220" MaxHeight="220" HorizontalAlignment="Center" Visibility="{Binding ShowJoinRequestQr, Converter={StaticResource BoolToVisibility}}">
                    <controls:QrCodeView Width="220" Height="220" Matrix="{Binding JoinRequestQr}" />
                  </Viewbox>
                  <Button Content="Copy Request" Command="{Binding CopyPeerCommand}" CommandParameter="{Binding JoinRequestQrCodeOrLink}" HorizontalAlignment="Center" Margin="0,8,0,10" Visibility="{Binding ShowJoinRequestQr, Converter={StaticResource BoolToVisibility}}" />
                  <Expander Header="Manual join" Margin="0,8,0,0" AutomationProperties.AutomationId="ManualJoinExpander">
                    <StackPanel Margin="0,8,0,0">
                      <TextBlock Text="Give the admin your Device ID. Enter their Device ID and Network ID here; they must add your Device ID too." Style="{StaticResource HelperText}" Margin="0,0,0,8" />
                      <TextBlock Text="{Binding State.OwnNpub}" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="ManualJoinJoinerDeviceIdValue" />
                      <Button Content="Copy my Device ID" Command="{Binding CopyPeerCommand}" CommandParameter="{Binding State.OwnNpub}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                      <TextBox Text="{Binding ManualJoinAdminId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Admin Device ID" Margin="0,0,0,6" AutomationProperties.AutomationId="ManualJoinAdminId" />
                      <TextBlock Text="Not a valid device ID" Foreground="{DynamicResource Danger}" FontSize="11" Visibility="{Binding ManualJoinAdminErrorVisibility}" />
                      <TextBox Text="{Binding ManualJoinMeshId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Network ID" Margin="0,6,0,8" AutomationProperties.AutomationId="ManualJoinNetworkId" />
                      <Button Content="Add manually" Command="{Binding ManualAddNetworkCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ManualJoinSubmit" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </StackPanel>

            <Grid Visibility="{Binding HasActiveNetwork, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Command="{Binding ShowAddDeviceCommand}" Content="+ Add device" Visibility="{Binding ActiveNetwork.LocalIsAdmin, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ManualJoinAdminOpen" />
                    <StackPanel>
                      <TextBlock Text="Devices" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding HeroSubtitle}" Style="{StaticResource HelperText}" Margin="0,3,0,0" />
                    </StackPanel>
                  </DockPanel>

                  <ListBox ItemsSource="{Binding ActiveNetwork.Participants}"
                           SelectedValue="{Binding SelectedParticipantKey, Mode=TwoWay}"
                           SelectedValuePath="SelectionKey"
                           BorderThickness="0"
                           Background="Transparent"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,14,0,0"
                           HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border>
                          <Border.Style>
                            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
                              <Setter Property="Padding" Value="12" />
                              <Setter Property="Margin" Value="0,0,0,8" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="16" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <StackPanel Grid.Column="1">
                              <WrapPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="This device" Margin="8,0,0,0" Foreground="{DynamicResource Ok}" Visibility="{Binding IsSelf, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Admin" Margin="8,0,0,0" Foreground="{DynamicResource Accent}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Exit" Margin="8,0,0,0" Foreground="{DynamicResource Warn}" Visibility="{Binding OffersExitNode, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="via mesh" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding IsFipsRouted, Converter={StaticResource BoolToVisibility}}" />
                              </WrapPanel>
                              <TextBlock Style="{StaticResource HelperText}" Margin="0,4,0,0">
                                <Run Text="{Binding CleanTunnelIp, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ConnectivityStateText, Mode=OneWay}" />
                              </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Copy" Tag="{Binding Npub}" Click="CopyPeer_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="{Binding AcceptedRosterAutomationId}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Visibility="{Binding SelectedParticipant, Converter={StaticResource ObjectToVisibility}}">
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource TextSecondary}" Margin="0,6,7,0" />
                        <TextBlock Text="{Binding SelectedParticipant.ConnectivityStateText}" Foreground="{DynamicResource TextSecondary}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding SelectedParticipant.DisplayName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0">
                          <TextBlock Text="This device" Foreground="{DynamicResource Ok}" Margin="0,0,10,0" Visibility="{Binding SelectedParticipant.IsSelf, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="Admin" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" Visibility="{Binding SelectedParticipant.IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="Exit" Foreground="{DynamicResource Warn}" Margin="0,0,10,0" Visibility="{Binding SelectedParticipant.OffersExitNode, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="direct connection" Foreground="{DynamicResource Ok}" Margin="0,0,10,0" Visibility="{Binding SelectedParticipant.IsFipsDirect, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="via mesh" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" Visibility="{Binding SelectedParticipant.IsFipsRouted, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                      </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,20,0,0" Visibility="{Binding SelectedParticipantCanRename, Converter={StaticResource BoolToVisibility}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Name" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                      <TextBox x:Name="AliasInput" Grid.Column="1" Text="{Binding SelectedParticipant.MagicDnsAlias, Mode=OneWay}" Margin="0,0,8,0" />
                      <Button Grid.Column="2" Content="Save" Tag="{Binding SelectedParticipant}" Click="SetParticipantAlias_Click" Margin="0,0,8,0" />
                      <Button Grid.Column="3" Content="Admin" Tag="{Binding SelectedParticipant}" Click="ToggleAdmin_Click" Margin="0,0,8,0" Visibility="{Binding SelectedParticipantCanManage, Converter={StaticResource BoolToVisibility}}" />
                      <Button Grid.Column="4" Content="Remove" Tag="{Binding SelectedParticipant}" Click="RemoveParticipant_Click" Visibility="{Binding SelectedParticipantCanManage, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Grid Margin="0,10,0,0" Visibility="{Binding SelectedParticipantCanManage, Converter={StaticResource BoolToVisibility}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Hints" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                      <TextBox x:Name="EndpointHintsInput" Grid.Column="1" Text="{Binding SelectedParticipant.FipsEndpointHintsEditText, Mode=OneWay}" ToolTip="host or host:port" Margin="0,0,8,0" />
                      <Button Grid.Column="2" Content="Save" Tag="{Binding SelectedParticipant}" Click="SetEndpointHints_Click" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0">
                      <StackPanel>
                        <TextBlock Text="Addresses" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="MagicDNS" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                          <TextBlock Grid.Column="1" Text="{Binding SelectedParticipant.MagicDnsDisplay}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                          <TextBlock Grid.Row="1" Text="VPN IP" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,8" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedParticipant.CleanTunnelIp}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                          <TextBlock Grid.Row="2" Text="Device ID" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                          <DockPanel Grid.Row="2" Grid.Column="1" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="Copy" Tag="{Binding SelectedParticipant.Npub}" Click="CopyPeer_Click" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding SelectedParticipant.Npub}" TextWrapping="Wrap" />
                          </DockPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0">
                      <StackPanel>
                        <TextBlock Text="Connectivity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <UniformGrid Columns="3" Rows="3">
                          <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="Role" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.RoleText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="State" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.ConnectivityStateText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,12">
                            <TextBlock Text="FIPS path" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.FipsPathText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Last seen" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.LastSeenDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Latency age" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.FipsSrttAgeDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Control seen" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.LastFipsControlSeenDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Data seen" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.LastFipsDataSeenDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Sent" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.TxBytesDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Received" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedParticipant.RxBytesDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,0,12,0">
                          <TextBlock Text="Address hints" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                          <TextBlock Text="{Binding SelectedParticipant.FipsEndpointHintsText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedParticipant.StatusDetailText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Visibility="{Binding SelectedParticipant, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="Devices" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="No devices yet" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <!-- ==================== Add Network ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=AddNetwork}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowNetworkSetupChoices, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Set up your network" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="A network is a private group of devices that can reach each other." Style="{StaticResource HelperText}" Margin="0,0,0,12" />
                <Button Content="Create Network" Command="{Binding ShowCreateNetworkSetupCommand}" Margin="0,0,0,8" AutomationProperties.AutomationId="ManualJoinCreateNetworkChoice" />
                <Button Content="Join Network" Command="{Binding ShowJoinNetworkSetupCommand}" AutomationProperties.AutomationId="ManualJoinChooseJoin" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowNetworkSetupCreate, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Button Content="Back" Command="{Binding BackToNetworkSetupChoicesCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBlock Text="Create Network" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding NetworkNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.AutomationId="ManualJoinCreateNetworkName" />
                  <Button Grid.Column="1" Content="Create" Command="{Binding CreateNetworkCommand}" AutomationProperties.AutomationId="ManualJoinCreateNetworkSubmit" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowNetworkSetupJoin, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <Button Content="Back" Command="{Binding BackToNetworkSetupChoicesCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBlock Text="Join Network" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="220" MaxHeight="220" HorizontalAlignment="Center" Visibility="{Binding ShowJoinRequestQr, Converter={StaticResource BoolToVisibility}}">
                  <controls:QrCodeView Width="220" Height="220" Matrix="{Binding JoinRequestQr}" />
                </Viewbox>
                <Button Content="Copy Request" Command="{Binding CopyPeerCommand}" CommandParameter="{Binding JoinRequestQrCodeOrLink}" HorizontalAlignment="Center" Margin="0,8,0,10" Visibility="{Binding ShowJoinRequestQr, Converter={StaticResource BoolToVisibility}}" />
                <Expander Header="Manual join" Margin="0,8,0,0" AutomationProperties.AutomationId="ManualJoinExpander">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Give the admin your Device ID. Enter their Device ID and Network ID here; they must add your Device ID too." Style="{StaticResource HelperText}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding State.OwnNpub}" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="ManualJoinJoinerDeviceIdValue" />
                    <Button Content="Copy my Device ID" Command="{Binding CopyPeerCommand}" CommandParameter="{Binding State.OwnNpub}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    <TextBox Text="{Binding ManualJoinAdminId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Admin Device ID" Margin="0,0,0,6" AutomationProperties.AutomationId="ManualJoinAdminId" />
                    <TextBlock Text="Not a valid device ID" Foreground="{DynamicResource Danger}" FontSize="11" Visibility="{Binding ManualJoinAdminErrorVisibility}" />
                    <TextBox Text="{Binding ManualJoinMeshId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Network ID" Margin="0,6,0,8" AutomationProperties.AutomationId="ManualJoinNetworkId" />
                    <Button Content="Add manually" Command="{Binding ManualAddNetworkCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ManualJoinSubmit" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ==================== Add Device ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=AddDevice}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowLinkDeviceCard, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Link Device" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="Paste the joiner's request to open confirmation automatically, or add their Device ID below." Style="{StaticResource HelperText}" Margin="0,0,0,10" />
                <TextBox Text="{Binding JoinRequestInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Join request" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="Import join request QR file" Command="{Binding ImportJoinRequestQrImageCommand}" Margin="0,0,8,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding ActiveNetwork.LocalIsAdmin, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="For manual join" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Share your Device ID and Network ID, then add the joining Device ID below." Style="{StaticResource HelperText}" Margin="0,4,0,10" />
                <TextBlock Text="{Binding State.OwnNpub}" TextWrapping="Wrap" Margin="0,0,0,4" AutomationProperties.AutomationId="ManualJoinAdminDeviceIdValue" />
                <TextBlock Text="{Binding ActiveNetwork.NetworkId}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.AutomationId="ManualJoinAdminNetworkIdValue" />
                <Button Content="Copy admin Device ID" Command="{Binding CopyPeerCommand}" CommandParameter="{Binding State.OwnNpub}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                <Button Content="Copy Network ID" Command="{Binding CopyNetworkIdCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBox Text="{Binding ParticipantInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Joining Device ID" Margin="0,0,0,4" AutomationProperties.AutomationId="ManualJoinAdminDeviceId" />
                <TextBlock Text="Not a valid device ID" Foreground="{DynamicResource Danger}" FontSize="11" Visibility="{Binding ParticipantInputErrorVisibility}" />
                <TextBox Text="{Binding ParticipantAliasInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name" Margin="0,6,0,8" AutomationProperties.AutomationId="ManualJoinAdminDeviceName" />
                <Button Content="Add by Device ID" Command="{Binding AddParticipantCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ManualJoinAdminSubmit" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ==================== Internet ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Internet}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Internet Source" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding State.ExitNodeStatusText}" Style="{StaticResource HelperText}" Margin="0,2,0,10" AutomationProperties.AutomationId="InternetSourceStatus" />
                <Button Click="DirectExit_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                  <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" Text="Use this device's normal internet" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding DirectExitMarker}" Margin="0,0,8,0" />
                    <TextBlock Text="This device" FontWeight="SemiBold" />
                  </DockPanel>
                </Button>
                <Button Click="WireguardExit_Click" IsEnabled="{Binding State.WireguardExitConfigured}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                  <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding WireguardExitSubtitle}" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding WireguardExitMarker}" Margin="0,0,8,0" />
                    <TextBlock Text="WireGuard upstream" FontWeight="SemiBold" />
                  </DockPanel>
                </Button>
                <Button Click="PaidAutomaticExit_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Visibility="{Binding PaidRouteMarketVisible, Converter={StaticResource BoolToVisibility}}">
                  <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" Text="Experimental · choose a working, reasonably priced provider" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding PaidAutomaticExitMarker}" Margin="0,0,8,0" />
                    <TextBlock Text="Paid · Automatic · Experimental" FontWeight="SemiBold" />
                  </DockPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding AutomaticProviderSelected, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl ItemsSource="{Binding ActiveAutomaticPaidSessions}">
                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                      <Button x:Name="ExitThumbUp" Content="{Binding RatingUpText}" Tag="{Binding}" Click="RatePaidExit_Click" ToolTip="Publish or clear your positive rating" Margin="0,0,6,0" />
                      <Button x:Name="ExitThumbDown" Content="{Binding RatingDownText}" Tag="{Binding}" Click="RatePaidExit_Click" ToolTip="Publish a negative rating and find another provider" Margin="0,0,6,0" />
                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Try another" Click="ReselectPaidExit_Click" />
                </StackPanel>
                <Button Click="PaidManualExit_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Visibility="{Binding PaidRouteMarketVisible, Converter={StaticResource BoolToVisibility}}">
                  <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Right" Text="Experimental · browse internet sellers" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding PaidManualExitMarker}" Margin="0,0,8,0" />
                    <TextBlock Text="Paid · Choose manually" FontWeight="SemiBold" />
                  </DockPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding ExitNodeParticipants}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Tag="{Binding Npub}" Click="SetExitNode_Click" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                        <DockPanel LastChildFill="False">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                          <TextBlock Text="{Binding MagicDnsName}" FontWeight="SemiBold" />
                        </DockPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Share this device's internet" IsChecked="{Binding State.AdvertiseExitNode, Mode=OneWay}" Click="AdvertiseExit_Click" />
                <CheckBox Style="{StaticResource SwitchCheckBox}" Content="Block internet if source disconnects" IsChecked="{Binding State.ExitNodeLeakProtection, Mode=OneWay}" Click="ExitLeakProtection_Click" Margin="0,10,0,0" />
                <Button Content="Sell internet access · Experimental" Command="{Binding ShowSellAccessCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding PaidExitSellerVisible, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="WireGuard Upstream" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="Paste a WireGuard config from an upstream VPN provider such as Mullvad or Proton VPN." Style="{StaticResource HelperText}" Margin="0,0,0,10" />
                <TextBox Text="{Binding WireguardExitConfig, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" MinHeight="180" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Import File" Command="{Binding ImportWireGuardExitCommand}" Margin="0,0,8,0" />
                  <Button Content="Save WireGuard" Command="{Binding SaveWireGuardExitCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Exit DNS" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="MagicDNS stays local. Public DNS follows this policy while an internet exit is active." Style="{StaticResource HelperText}" Margin="0,4,0,10" />
                <TextBlock Text="Mode" FontWeight="SemiBold" />
                <ComboBox SelectedValue="{Binding ExitDnsMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Margin="0,4,0,10" AutomationProperties.AutomationId="ExitDnsMode">
                  <ComboBoxItem Tag="automatic" Content="Automatic (recommended)" />
                  <ComboBoxItem Tag="encrypted" Content="Encrypted DNS" />
                  <ComboBoxItem Tag="through_exit" Content="DNS through exit" />
                </ComboBox>
                <StackPanel Visibility="{Binding ExitDnsEncryptedSelected, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Provider" FontWeight="SemiBold" />
                  <ComboBox SelectedValue="{Binding ExitDnsDohProvider, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Margin="0,4,0,10" AutomationProperties.AutomationId="ExitDnsProvider">
                    <ComboBoxItem Tag="cloudflare" Content="Cloudflare" />
                    <ComboBoxItem Tag="quad9" Content="Quad9" />
                    <ComboBoxItem Tag="custom" Content="Custom DoH" />
                  </ComboBox>
                  <StackPanel Visibility="{Binding ExitDnsCustomSelected, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Text="{Binding ExitDnsCustomDohUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="HTTPS DoH URL" AutomationProperties.AutomationId="ExitDnsCustomUrl" />
                    <TextBox Text="{Binding ExitDnsCustomDohBootstrapIps, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Bootstrap IPs, comma separated" AutomationProperties.AutomationId="ExitDnsBootstrapIps" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding ExitDnsThroughExitSelected, Converter={StaticResource BoolToVisibility}}">
                  <TextBox Text="{Binding ExitDnsThroughExitServers, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="DNS server IPs, comma separated" AutomationProperties.AutomationId="ExitDnsThroughServers" />
                  <TextBlock Text="These DNS packets are sent only through the selected exit." Style="{StaticResource HelperText}" Margin="0,0,0,8" />
                </StackPanel>
                <TextBlock Text="Automatic uses profile DNS when supplied; otherwise built-in encrypted DNS." Style="{StaticResource HelperText}" Margin="0,0,0,10" />
                <Button Content="Save Exit DNS" Command="{Binding SaveExitDnsCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ExitDnsSave" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ==================== Public Exits ==================== -->
          <StackPanel Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=PublicExits}">
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Back" VerticalAlignment="Center" /></StackPanel></Button>
            <TextBlock Text="{Binding State.ExitNodeStatusText}" Style="{StaticResource HelperText}" Margin="0,0,0,10" AutomationProperties.AutomationId="PaidExitCurrentInternet" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Find" Click="DiscoverPaidRoutes_Click" Margin="0,0,8,0" />
                    <Button Content="Pay" Click="StreamPaidRoutePayments_Click" IsEnabled="{Binding PaidRouteHasStreamablePayments}" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Find Internet to Buy" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Experimental" Style="{StaticResource HelperText}" />
                    <TextBlock Style="{StaticResource HelperText}">
                      <Run Text="Wallet " /><Run Text="{Binding PaidRouteWalletBalanceText, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding State.ExitNodeStatusText}" Style="{StaticResource HelperText}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding PaidRouteMarketStatusText}" Style="{StaticResource HelperText}" Margin="0,0,0,8" />
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Add provider" Click="SetManualPaidExitProvider_Click" IsEnabled="{Binding CanSetManualPaidExitProvider}" Margin="0,0,8,0" />
                    <Button Content="Clear" Click="ClearManualPaidExitProvider_Click" Visibility="{Binding State.PaidRouteMarket.ManualProviderLink, Converter={StaticResource NonEmptyStringToVisibility}}" />
                  </StackPanel>
                  <TextBox Text="{Binding ManualPaidExitProvider, UpdateSourceTrigger=PropertyChanged}" ToolTip="Provider npub or paid exit link" AutomationProperties.AutomationId="ManualPaidExitProvider" />
                </DockPanel>
                <TextBlock Text="{Binding State.PaidRouteMarket.ManualProviderStatusText}" Style="{StaticResource HelperText}" Margin="0,0,0,8" Visibility="{Binding State.PaidRouteMarket.ManualProviderStatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding PaidRouteFilterCountryCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Two-letter country" Margin="0,0,8,0" MaxLength="2" AutomationProperties.AutomationId="PaidRouteFilterCountry" />
                  <ComboBox Grid.Column="1" SelectedValue="{Binding PaidRouteFilterSort, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Margin="0,0,8,0" AutomationProperties.AutomationId="PaidRouteFilterSort">
                    <ComboBoxItem Tag="quality" Content="Quality" />
                    <ComboBoxItem Tag="price" Content="Price" />
                    <ComboBoxItem Tag="newest" Content="Newest" />
                  </ComboBox>
                  <CheckBox Grid.Column="2" Content="IPv4" IsChecked="{Binding PaidRouteFilterRequireIpv4}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <CheckBox Grid.Column="3" Content="IPv6" IsChecked="{Binding PaidRouteFilterRequireIpv6}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Content="Clear filters" Click="ClearPaidRouteFilter_Click" Margin="0,0,8,0" />
                    <Button Content="Apply" Click="ApplyPaidRouteFilter_Click" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PaidRouteHiddenOffersText}" Style="{StaticResource HelperText}" Margin="0,0,0,8" Visibility="{Binding PaidRouteHiddenOffersText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                <TextBlock Text="{Binding State.PaidRouteMarket.LastPaymentAction.DisplayStatusText}" Style="{StaticResource HelperText}" TextWrapping="Wrap" Visibility="{Binding State.PaidRouteMarket.LastPaymentAction.DisplayStatusText, Converter={StaticResource NonEmptyStringToVisibility}}" />
                <Button Content="Send payment" Click="SendPaidRoutePaymentEnvelope_Click" HorizontalAlignment="Left" Margin="0,6,0,10" Visibility="{Binding State.PaidRouteMarket.LastPaymentAction.EnvelopeJson, Converter={StaticResource NonEmptyStringToVisibility}}" />
                <TextBlock Text="Available" FontWeight="SemiBold" Margin="0,8,0,6" />
                <ItemsControl ItemsSource="{Binding PaidRouteVisibleOffers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,8" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <Button x:Name="ExitThumbUp" Content="{Binding RatingUpText}" Tag="{Binding}" Click="RatePaidExit_Click" Visibility="{Binding CanRate, Converter={StaticResource BoolToVisibility}}" ToolTip="Publish or clear your positive rating" Margin="0,0,6,0" />
                          <Button x:Name="ExitThumbDown" Content="{Binding RatingDownText}" Tag="{Binding}" Click="RatePaidExit_Click" Visibility="{Binding CanRate, Converter={StaticResource BoolToVisibility}}" ToolTip="Publish or clear your negative rating; stops this provider" Margin="0,0,6,0" />
